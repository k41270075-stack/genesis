{
  "name": "vouchai-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VouchAI: every command of the RL environment, drawn next to its real recorded terminal output",
  "scripts": {
    "data": "cd .. && python site/build_data.py",
    "check-data": "cd .. && python site/check_data.py",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/pt-serif": "5.1.0",
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "framer-motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
